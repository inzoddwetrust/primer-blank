# Rendered by the nginx image's entrypoint when the container starts
# (/etc/nginx/templates -> /etc/nginx/conf.d), with API_BASE_URL, LANGUAGES
# and DEFAULT_LANGUAGE only (NGINX_ENVSUBST_FILTER in the Dockerfile).
# API_BASE_URL is the API host (contract 3 rule 18); the page gets the origin,
# the scheme added here. LANGUAGES -- the instance's languages, codes by commas
# in the passport's order -- and DEFAULT_LANGUAGE, one of them (protocol
# 5.2.2), go to the page as they are; it checks them (src/config.ts).
#
# Without one of them the placeholder stays as written, nginx reads it as an
# unknown variable and refuses to start: the container does not come up.
#
# The instance's packages (primer.yaml packages, apply: runtime) are mounted
# read-only at /srv/skin and /srv/texts; nginx/package.js serves them as
# /skin.css and /texts.json, each checked once and its answer kept in the
# shared dictionary primer -- an empty skin.css and {} when no package is
# mounted: the page keeps its built-in theme and texts. The module is loaded
# in nginx.conf (load_module, the Dockerfile).

# Two answers, a few kilobytes each; the zone lives as long as the container.
js_shared_dict_zone zone=primer:1m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    js_import primer from /usr/local/lib/primer/package.js;

    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"apiBaseUrl":"https://${API_BASE_URL}","languages":"${LANGUAGES}","defaultLanguage":"${DEFAULT_LANGUAGE}"}';
    }

    location = /skin.css {
        add_header Cache-Control "no-cache" always;
        js_content primer.skinCss;
    }

    location = /texts.json {
        add_header Cache-Control "no-store" always;
        js_content primer.textsJson;
    }

    # The skin's images, as the package has them; none without a package.
    # An SVG opened by its address runs nothing and loads nothing: the
    # package's check refuses scripts and links, and this policy holds when a
    # pattern of the check is passed by.
    location ^~ /skin/assets/ {
        alias /srv/skin/assets/;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Hashed build output: a missing file is a 404, never the page.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Every other path is a route of the single-page app.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
